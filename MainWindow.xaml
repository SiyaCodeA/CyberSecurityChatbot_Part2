<Window x:Class="CyberSecurityChatbot_Part2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cyber Security Awareness Chatbot"
        Height="620" Width="650"
        WindowStartupLocation="CenterScreen"
        Background="Black"
        Loaded="Window_Loaded">

    <Grid>

        <Label Content="CYBER SECURITY ASSISTANT"
               HorizontalAlignment="Center"
               VerticalAlignment="Top"
               Margin="0,10,0,0"
               Foreground="Lime"
               FontFamily="Consolas"
               FontSize="22"
               FontWeight="Bold"/>

       
        <RichTextBox Name="rtbChat"
                     Margin="20,60,20,220"
                     Background="Black"
                     Foreground="Lime"
                     FontFamily="Consolas"
                     FontSize="13"
                     IsReadOnly="True"/>

        
        <StackPanel Name="pnlMenu"
                    VerticalAlignment="Bottom"
                    Margin="20,0,20,30"
                    Visibility="Collapsed">

            <TextBlock Text="════════════════════════════════"
                       Foreground="Lime" FontFamily="Consolas"
                       HorizontalAlignment="Center" Margin="0,0,0,5"/>

            <Button Name="btn1"
                    Content="1 — Ask a Cybersecurity Question"
                    Height="40" Margin="0,5"
                    Background="#001a00" Foreground="Lime"
                    FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                    BorderBrush="Lime"
                    Click="btn1_Click"/>

            <Button Name="btn2"
                    Content="2 — Water the Flower "
                    Height="40" Margin="0,5"
                    Background="#001a00" Foreground="Lime"
                    FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                    BorderBrush="Lime"
                    Click="btn2_Click"/>

            <Button Name="btn3"
                    Content="3 — Exit"
                    Height="40" Margin="0,5"
                    Background="#1a0000" Foreground="Red"
                    FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                    BorderBrush="Red"
                    Click="btn3_Click"/>

            <TextBlock Text="════════════════════════════════"
                       Foreground="Lime" FontFamily="Consolas"
                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>

        
        <Grid Name="pnlInput"
              VerticalAlignment="Bottom"
              Margin="20,0,20,30"
              Visibility="Visible">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>

            <TextBox Name="txtUserInput"
                     Grid.Column="0"
                     Height="38"
                     Background="#0d0d0d"
                     Foreground="Lime"
                     FontFamily="Consolas"
                     FontSize="14"
                     CaretBrush="Lime"
                     BorderBrush="Lime"
                     Padding="5,5"
                     KeyDown="txtUserInput_KeyDown"/>

            <Button Name="btnSend"
                    Grid.Column="1"
                    Content="Send"
                    Height="38" Margin="8,0,0,0"
                    Background="Black" Foreground="Lime"
                    BorderBrush="Lime"
                    FontFamily="Consolas" FontWeight="Bold"
                    Click="btnSend_Click"/>

            <Button Name="btnBack"
                    Grid.Column="2"
                    Content="◀ Menu"
                    Height="38" Margin="8,0,0,0"
                    Background="Black" Foreground="Yellow"
                    BorderBrush="Yellow"
                    FontFamily="Consolas" FontWeight="Bold"
                    Visibility="Collapsed"
                    Click="btnBack_Click"/>
        </Grid>

    </Grid>
</Window>